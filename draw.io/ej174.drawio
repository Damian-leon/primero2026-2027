        <mxCell id="lee" parent="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixed=1;size=0.09375;fillColor=none;spacingLeft=12;spacingRight=12;html=1;whiteSpace=wrap;fontSize=13;" value="Presentar(&quot;Ingrese el código de usuario:&quot;)&lt;br&gt;Leer codigo&lt;br&gt;Presentar(&quot;Ingrese la hora de acceso (0 - 23):&quot;)&lt;br&gt;Leer hora&lt;br&gt;Presentar(&quot;Ingrese el día (1 a 7):&quot;)&lt;br&gt;Leer dia&lt;br&gt;Presentar(&quot;Ingrese el tipo de usuario (A, E, V):&quot;)&lt;br&gt;Leer tipo_usuario" vertex="1">
          <mxGeometry height="137" width="480" x="200" y="380" as="geometry" />
        </mxCell>
        <mxCell id="dn" parent="1" style="rounded=0;fillColor=none;spacingLeft=6;spacingRight=6;html=1;whiteSpace=wrap;fontSize=13;" value="dia_num = dia - &#39;0&#39;" vertex="1">
          <mxGeometry height="36" width="210" x="335" y="540" as="geometry" />
        </mxCell>
        <mxCell id="dv" parent="1" style="rounded=0;fillColor=none;spacingLeft=6;spacingRight=6;html=1;whiteSpace=wrap;fontSize=13;" value="datos_validos = (codigo &gt; 0 AND hora &gt;= 0 AND hora &lt;= 23 AND dia_num &gt;= 1 AND dia_num &lt;= 7 AND (tipo_usuario == &#39;A&#39; OR tipo_usuario == &#39;E&#39; OR tipo_usuario == &#39;V&#39;))" vertex="1">
          <mxGeometry height="75" width="540" x="170" y="600" as="geometry" />
        </mxCell>
        <mxCell id="d0" parent="1" style="rhombus;fillColor=none;html=1;whiteSpace=wrap;fontSize=13;" value="datos_validos?" vertex="1">
